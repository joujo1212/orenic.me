---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const dateFormatter = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={project.data.title} description={project.data.short_description}>
  <main class="mx-auto min-h-screen w-full max-w-6xl px-5 py-8 sm:px-8 lg:px-10">
    <nav class="mb-8">
      <a href="/" class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-sm font-semibold text-slate-300 transition hover:border-cyan-glow/40 hover:text-white">
        <span aria-hidden="true">&lt;</span>
        Back to timeline
      </a>
    </nav>

    <article>
      <header class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <time class="text-sm font-semibold uppercase tracking-[0.28em] text-cyan-glow">
            {dateFormatter.format(project.data.date)}
          </time>
          <h1 class="mt-4 text-5xl font-black tracking-[-0.06em] text-white sm:text-7xl">
            {project.data.title}
          </h1>
        </div>
        <p class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-6 text-lg leading-8 text-slate-300 shadow-2xl shadow-black/20">
          {project.data.short_description}
        </p>
      </header>

      <figure class="mt-10 overflow-hidden rounded-[2rem] border border-white/10 bg-panel shadow-2xl shadow-black/30">
        <img src={project.data.main_image} alt="" class="aspect-[16/10] w-full object-cover" />
      </figure>

      <div class="mt-12 grid gap-10 lg:grid-cols-[0.72fr_0.28fr]">
        <div class="rounded-[2rem] border border-white/10 bg-white/[0.035] p-6 text-lg leading-8 text-slate-300 shadow-2xl shadow-black/20 sm:p-8 [&_p+p]:mt-6 [&_strong]:text-white">
          <Content />
        </div>

        <aside class="h-fit rounded-[2rem] border border-cyan-glow/20 bg-cyan-glow/10 p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-glow">Project file</p>
          <p class="mt-3 break-all font-mono text-sm text-slate-300">
            src/content/projects/{project.id}.md
          </p>
          <p class="mt-6 text-sm leading-6 text-slate-400">
            Edit this Markdown file directly or manage it visually from Decap CMS.
          </p>
        </aside>
      </div>

      {
        project.data.gallery_images.length > 0 && (
          <section aria-labelledby="gallery-heading" class="mt-16 pb-20">
            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-violet-glow">
              Visual notes
            </p>
            <h2 id="gallery-heading" class="mt-3 text-3xl font-black tracking-tight text-white sm:text-5xl">
              Gallery
            </h2>
            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              {project.data.gallery_images.map((image) => (
                <figure class="overflow-hidden rounded-[1.5rem] border border-white/10 bg-panel">
                  <img src={image} alt="" loading="lazy" class="aspect-[16/10] w-full object-cover transition duration-500 hover:scale-105" />
                </figure>
              ))}
            </div>
          </section>
        )
      }
    </article>
  </main>
</BaseLayout>
